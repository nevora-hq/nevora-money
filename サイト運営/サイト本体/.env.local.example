# ローカル開発でcanonical・og:url・構造化データ(JSON-LD)を検証するための設定例。
# .env.local に無い場合はこのファイルをコピーして使ってください:
#   cp .env.local.example .env.local (Windowsは copy .env.local.example .env.local)
# 既に .env.local がある場合は、この行だけ追記してください。
#
# NEXT_PUBLIC_SITE_URL が未設定だと、components/Layout.js の実装により
# canonical・og:url・構造化データのタグ自体が出力されないため、
# ローカルでは正しいURLが出ているかを確認できません(本番Vercelには設定済み)。
NEXT_PUBLIC_SITE_URL=https://nevora-money.vercel.app

# 検索エンジンへのインデックス許可フラグ。
# 未設定(または"1"以外)の間は、全ページに noindex,nofollow のメタタグが入り、
# robots.txt も "Disallow: /" を返す(ドメイン確定前の暫定公開用)。
# ただしSNSのリンクプレビュー用UA(Twitterbot等)だけはAllowするため、OGPカードは確認できる。
# 正式公開時にVercelの環境変数へ NEXT_PUBLIC_ALLOW_INDEX=1 を設定して解除する。
# NEXT_PUBLIC_ALLOW_INDEX=1
