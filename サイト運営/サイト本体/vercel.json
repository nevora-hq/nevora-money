{
  "rewrites": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "nevora-money.vercel.app" }],
      "destination": "/_gone_"
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "nevora-money.vercel.app" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
