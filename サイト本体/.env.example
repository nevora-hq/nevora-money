# Google Analytics 4 (GA4) の測定ID
# GAアカウントで「データストリーム」を作成すると発行される「G-XXXXXXXXXX」形式のIDを設定してください。
# 未設定のままでも動作しますが、その場合アクセス解析タグは読み込まれません。
# 本番(Vercelデプロイ)にのみ反映すればよく、開発環境では設定しなくても問題ありません。
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console(GSC)の所有権確認コード(metaタグ方式)
# GSCで「所有権の確認」→「HTMLタグ」を選ぶと発行される content="..." の値だけを設定してください。
# 例: <meta name="google-site-verification" content="abcdefgh12345" /> の場合は abcdefgh12345 を設定
# 未設定のままでも動作しますが、その場合はmetaタグが出力されず確認が完了しません。
# なお、GSCの「HTMLファイル」方式を使う場合は、発行されたファイルを public/ フォルダ直下に置くだけで
# https://サイトURL/ファイル名 でアクセスできるようになります(この環境変数の設定は不要)。
NEXT_PUBLIC_GSC_VERIFICATION=

# サイトの本番URL(OGP画像・canonicalタグ・構造化データ(JSON-LD)などの
# 絶対URL生成に使用)
# 例: https://your-site.vercel.app (末尾のスラッシュは不要)
# 未設定の場合、OGP画像タグは相対パスのまま、canonical・og:url・構造化データは
# 出力されません(誤ったドメインのURLを出力しないための挙動)。
# なお sitemap.xml / robots.txt はこの値が未設定でもリクエスト先のホスト名から
# 自動的に絶対URLを補って生成されます。
NEXT_PUBLIC_SITE_URL=

# Google AdSenseの所有権確認・広告配信用クライアントID
# AdSenseの管理画面で発行される "ca-pub-XXXXXXXXXXXXXXXX" 形式のIDを設定してください。
# 未設定のままでも動作しますが、その場合はAdSenseコードが出力されず審査・広告配信ができません。
NEXT_PUBLIC_ADSENSE_CLIENT=
